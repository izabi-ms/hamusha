# Database
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/haimish

# Server
PORT=3000
NODE_ENV=development

# Better Auth
BETTER_AUTH_SECRET=your-super-secret-key-change-in-production-min-32-chars
BETTER_AUTH_URL=http://localhost:3000

# SSLCommerz (Sandbox) - Use test credentials from SSLCommerz
SSLCOMMERZ_STORE_ID=your_store_id
SSLCOMMERZ_STORE_PASSWORD=your_store_password
SSLCOMMERZ_SANDBOX=true
SSLCOMMERZ_SUCCESS_URL=http://localhost:5173/checkout/success
SSLCOMMERZ_FAIL_URL=http://localhost:5173/checkout/fail
SSLCOMMERZ_CANCEL_URL=http://localhost:5173/checkout/cancel
SSLCOMMERZ_IPN_URL=http://localhost:3000/api/payments/sslcommerz/ipn

# Frontend
FRONTEND_URL=http://localhost:5173